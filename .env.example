# ---------------------------------------------------------------------------
# Supabase — public, browser-safe values
# Project Settings → API → "Project URL" and "anon/public" key
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix these with NEXT_PUBLIC_
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle.
# ---------------------------------------------------------------------------

# Service role key. Bypasses Row Level Security.
# Required by: admin username→email login, staff account creation,
# product image upload/deletion, scripts/create-admin.mjs.
# If it leaks, rotate it immediately (Project Settings → API → Reset).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC secret for internal staff sessions (>= 32 characters).
# Generate: openssl rand -base64 48
# Staff sign-in fails closed (503) when this is missing in production.
EMPLOYEE_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Legacy aliases used by scripts/create-admin.mjs (optional).
# Prefer SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above.
# ---------------------------------------------------------------------------
# SUP_URL=https://your-project-ref.supabase.co
# SUP_ADMIN_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Optional: Supabase Edge Function secrets (set in Dashboard → Edge Functions,
# NOT here): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_SENDER
# ---------------------------------------------------------------------------
