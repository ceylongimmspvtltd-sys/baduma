# Supabase project credentials.
# Create a project at https://supabase.com and copy the URL and anon key here.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin API key — only needed to run scripts/create-admin.mjs (creates the
# Master Admin login). Find it at https://supabase.com/project/settings/api
SUP_URL=your-supabase-project-url
SUP_ADMIN_KEY=your-supabase-admin-api-key
